# KJC Capital — environment reference.
# Sensitive values marked (SENSITIVE) never come back from `vercel env pull`;
# fetch them from the originating dashboard.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # (SENSITIVE) bypasses RLS. Never NEXT_PUBLIC_. Never imported from a "use client" file.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://kjccapital.co.uk
NEXT_PUBLIC_FIRM_NAME="KJC Capital"
NEXT_PUBLIC_FUND_NAME="KJC Growth Fund"

# --- Auth -------------------------------------------------------------------
MFA_COOKIE_SECRET=                          # (SENSITIVE) 32-byte hex for AAL2 cookie signing.

# --- Broker (single house terminal) ----------------------------------------
BROKER_ENC_KEY=                             # (SENSITIVE) 32-byte hex. Decrypts the one house MT5 password.
BROKER_LOGIN=
BROKER_SERVER=

# --- Ingest -----------------------------------------------------------------
MT5_SYNC_SHARED_SECRET=                     # (SENSITIVE) posted from the house terminal in the payload.

# --- Alerts -----------------------------------------------------------------
SLACK_RISK_WEBHOOK_URL=                     # (SENSITIVE) private Slack incoming webhook, #risk channel.
ALERT_EMAIL_FALLBACK=risk@kjccapital.co.uk

# --- Email ------------------------------------------------------------------
RESEND_API_KEY=                             # (SENSITIVE)
RESEND_FROM="KJC Capital <no-reply@kjccapital.co.uk>"

# --- Cron -------------------------------------------------------------------
CRON_SECRET=                                # (SENSITIVE) Vercel cron authorization header.
